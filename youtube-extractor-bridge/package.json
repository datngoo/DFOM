{
  "name": "youtube-extractor-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Local Node.js bridge backend for resolving downloadable YouTube media URLs for the iOS app.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/**/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.7.0",
    "express": "^5.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "youtube-dl-exec": "3.0.25"
  }
}
